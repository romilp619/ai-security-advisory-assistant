# Existing project: AI Security Advisory Assistant. Never run sanity init.
SANITY_PROJECT_ID=o7qa6o3y
SANITY_DATASET=production
# Exact URL copied from your organization's Context app, Knowledge Base mode.
SANITY_CONTEXT_MCP_URL=
SANITY_ORGANIZATION_TOKEN=
# Project-level Viewer token for exact advisory verification (also for private datasets).
SANITY_READ_TOKEN=
# Project-level Editor token; local ingestion only. Do not set on the web deployment.
SANITY_WRITE_TOKEN=
# openai, anthropic, nvidia, or token-harbor. Select a model supporting structured output.
AI_PROVIDER=openai
AI_PROVIDER_API_KEY=
AI_MODEL=
# NVIDIA uses https://integrate.api.nvidia.com/v1 and Chat Completions.
# Token Harbor uses https://tokenharbor.ai/v1 with deepseek-v4.1-flash:free.
# Optional OpenAI provider URL; configured by operator, never by users.
AI_BASE_URL=
# Required for non-local deployments: exact public origin, no trailing slash.
APP_ORIGIN=http://localhost:3000
# Optional shared access code, required in production. Enter it in the research form.
RESEARCH_ACCESS_TOKEN=
# Optional GitHub token for higher ingestion rate limits. Never sent to Sanity.
GITHUB_TOKEN=
# Live test opt-in; consumes model tokens and requires all configuration above.
RUN_LIVE_TESTS=0
